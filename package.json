{
  "name": "arnx-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "format": "prettier --write src scripts tests worker .github package.json tsconfig.json eslint.config.js README.md",
    "format:check": "prettier --check src scripts tests worker .github package.json tsconfig.json eslint.config.js README.md",
    "lint": "eslint src scripts tests worker",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "verify:discovery": "node scripts/verify-discovery.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.2"
  },
  "license": "Apache-2.0"
}
