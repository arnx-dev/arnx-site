{
  "name": "arnx-pilot-form",
  "main": "index.ts",
  "compatibility_date": "2026-10-15",
  "vars": {
    "PILOT_TO": "info@arnx.dev",
    "ALLOWED_ORIGINS": "https://arnx.dev,https://www.arnx.dev,https://arnx-dev.github.io",
  },
  "ratelimits": [
    {
      "name": "PILOT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
}
